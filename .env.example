# ─────────────────────────────────────────────
# PILKETOS — Environment untuk local/Vercel
# Jangan commit .env berisi secret asli.
# ─────────────────────────────────────────────

# Password dashboard admin
ADMIN_PASSWORD=ganti-dengan-password-admin-yang-kuat

# Secret untuk menandatangani session cookie admin (minimal 32 byte acak).
# Jika belum diisi, aplikasi fallback ke VOTE_TOKEN_SECRET lalu ADMIN_PASSWORD,
# tetapi secret terpisah lebih direkomendasikan.
ADMIN_SESSION_SECRET=ganti-dengan-random-secret-64-karakter

# Secret terpisah untuk menandatangani vote token (minimal 32 byte acak).
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOTE_TOKEN_SECRET=ganti-dengan-random-secret-64-karakter

# Supabase server-side credentials.
# Gunakan Secret key (sb_secret_...), BUKAN publishable key.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nama bucket yang dibuat oleh supabase_schema.sql.
SUPABASE_STORAGE_BUCKET=pilketos-assets

# Hanya untuk local dev; Vercel mengatur port sendiri.
# PORT=3000

# Legacy compatibility saja. Jangan isi jika sudah memakai SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_KEY=legacy-service-role-key
